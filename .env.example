# ---------------------------------------------------------------------------
# Capital Ark environment
#
# The app runs with ZERO configuration in demo mode. Leave everything below
# unset and it serves seeded in-memory data so you can walk the full flow
# immediately. Fill these in to switch to a persistent deployment.
# ---------------------------------------------------------------------------

# Postgres connection (DigitalOcean or Supabase)
# Setting this switches the app off demo mode and onto Prisma.
DATABASE_URL=

# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL=

# Private CA certificate for managed PostgreSQL TLS verification. DigitalOcean
# deployments should bind this to `${<database-component>.CA_CERT}`.
DATABASE_CA_CERT=

# First-launch auth mode. `local` persists opaque visitor identities in
# Postgres but intentionally disables account claiming and receipt uploads.
# Use `supabase` only after filling both public keys and configuring Auth.
NEXT_PUBLIC_AUTH_MODE=local

# Operational kill switch for community-created drives. Public submissions are
# labeled unverified until a trusted review promotes them.
NEXT_PUBLIC_ENABLE_DRIVE_CREATION=true

# Supabase project (optional; Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile, used to gate anonymous sign-ins against abuse.
# Leave unset to skip the captcha in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional receipt consistency check. This key stays server-only. When absent,
# the UI keeps self-reporting available and does not offer AI receipt checking.
# The raw screenshot is sent to OpenAI only after explicit contributor consent
# and is not persisted by Capital Ark's AI path.
OPENAI_API_KEY=

# Fast image-capable default. Override only after evaluating representative
# processor receipts. `high` is the default because receipt text is often small;
# supported detail values are low, high, and auto.
OPENAI_RECEIPT_MODEL=gpt-5-mini
OPENAI_RECEIPT_IMAGE_DETAIL=high

# Salt for hashing IP addresses and signing local visitor identities. Production
# rejects this development placeholder; configure a stable encrypted random
# value of at least 32 characters. Rotating it signs every visitor out.
# Generate with: node -e "console.log(crypto.randomUUID())"
IP_HASH_SALT=dev-only-insecure-salt

# Public origin, used to build shareable links and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production seeding inserts only the audited NC slate. Set this only in a
# local development database to add the fictional multi-processor fixtures.
SEED_DEMO_DATA=false
